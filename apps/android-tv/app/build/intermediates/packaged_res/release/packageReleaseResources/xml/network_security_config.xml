<?xml version="1.0" encoding="utf-8"?>
<network-security-config>
    <!-- Xtream VOD often redirects HTTPS CDN → cleartext HTTP origin IPs. -->
    <base-config cleartextTrafficPermitted="true">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>
</network-security-config>
