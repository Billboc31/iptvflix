# Required
DATABASE_URL=postgresql://user:password@localhost:5432/iptvflix

# Optional — service port (default: 3001)
PORT=3001

# Optional — log level: trace | debug | info | warn | error (default: info)
LOG_LEVEL=info

# Optional — CORS allowed origin; defaults to * in dev
# Set to your recommendation-lab URL in production
CORS_ORIGIN=*

# Optional — enables llm-planner stage; service starts fine without it
OPENAI_API_KEY=
