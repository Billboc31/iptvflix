{
  "name": "@iptvflix/api",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/index.js",
    "start:railway": "node dist/index.js",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src",
    "test": "vitest run",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "node scripts/migrate-safe.mjs",
    "db:diagnose": "node scripts/diagnose-db.mjs",
    "db:migrate:drizzle-kit": "drizzle-kit migrate",
    "db:studio": "drizzle-kit studio",
    "db:validate-chain": "tsx scripts/validate-snapshot-chain.ts",
    "benchmark:embeddings": "tsx src/benchmarks/embedding-benchmarks.ts",
    "benchmark:planner": "tsx src/benchmarks/llm-planner-benchmarks.ts",
    "backfill:segments": "tsx src/scripts/backfill-segments.ts"
  },
  "dependencies": {
    "@iptvflix/api-contracts": "workspace:*",
    "@fastify/cookie": "^9.4.0",
    "@fastify/cors": "^9.0.0",
    "@fastify/jwt": "^8.0.1",
    "bcrypt": "^6.0.0",
    "openai": "^4.67.0",
    "dotenv": "^17.4.2",
    "drizzle-orm": "^0.45.2",
    "fastify": "^4.28.0",
    "postgres": "^3.4.9"
  },
  "devDependencies": {
    "@types/bcrypt": "^6.0.0",
    "@types/node": "^20.0.0",
    "@vitest/coverage-v8": "^2.0.0",
    "drizzle-kit": "^0.31.10",
    "msw": "^2.7.0",
    "tsx": "^4.0.0",
    "typescript": "^5.5.0",
    "vitest": "^2.0.0"
  }
}
