# Dependencies
node_modules/
.pnpm-store/

# Build outputs
dist/
apps/web/dist/
build/
out/
# Environment files
.env
.env.local
.env.*.local
# Android
.gradle/
*.apk
*.aab
apps/android-tv/local.properties
apps/android-tv/.idea/
apps/android-tv/app/build/
# Editor
.DS_Store
*.swp
*.swo
# Vite
.vite/

# TypeScript emit artifacts in src/ (tsc --declaration side-effects)
apps/web/src/**/*.js
apps/web/src/**/*.js.map
apps/web/src/**/*.d.ts
apps/web/src/**/*.d.ts.map
apps/web/vite.config.js
apps/web/vite.config.js.map
apps/web/vite.config.d.ts
apps/web/vite.config.d.ts.map
# Re-include the real Vite ambient types file
!apps/web/src/vite-env.d.ts
# Playwright
e2e/playwright-report/
e2e/test-results/
e2e/.fake-servers.json

# Live TV TypeScript emit artifacts
apps/live-tv/src/**/*.js
apps/live-tv/src/**/*.js.map
apps/live-tv/src/**/*.d.ts
apps/live-tv/src/**/*.d.ts.map
apps/live-tv/vite.config.js
apps/live-tv/vite.config.js.map
apps/live-tv/vite.config.d.ts
apps/live-tv/vite.config.d.ts.map
!apps/live-tv/src/vite-env.d.ts
