{
  "name": "iptvflix",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "pnpm --parallel --filter './apps/*' dev",
    "reset-local": "bash scripts/reset-local.sh",
    "start-local": "bash scripts/start-local.sh",
    "build": "pnpm --filter './packages/*' build && pnpm --filter './apps/*' build",
    "lint": "pnpm --filter './packages/*' --filter './apps/api' --filter './apps/web' lint",
    "typecheck": "pnpm --filter './packages/*' --filter './apps/api' --filter './apps/web' typecheck",
    "test": "pnpm --filter './apps/api' test",
    "test:e2e": "pnpm --filter @iptvflix/e2e test",
    "validate": "pnpm build && pnpm typecheck && pnpm test"
  },
  "devDependencies": {
    "@typescript-eslint/eslint-plugin": "^8.0.0",
    "@typescript-eslint/parser": "^8.0.0",
    "eslint": "^9.0.0",
    "eslint-config-prettier": "^9.0.0",
    "prettier": "^3.0.0",
    "typescript": "^5.5.0"
  },
  "engines": {
    "node": ">=20.0.0",
    "pnpm": ">=9.0.0"
  },
  "packageManager": "pnpm@9.15.0"
}
